{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hermes Transcript Contract v2",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "producer_version",
    "source_fingerprint",
    "config_fingerprint",
    "created_at",
    "upstream_artifacts",
    "language",
    "duration",
    "segments"
  ],
  "properties": {
    "artifact_type": {
      "const": "transcript"
    },
    "schema_version": {
      "const": "2.0"
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "source_fingerprint": {
      "$ref": "#/definitions/fingerprint"
    },
    "config_fingerprint": {
      "$ref": "#/definitions/fingerprint"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "upstream_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/fingerprint"
      },
      "uniqueItems": true
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "id": {
            "type": ["integer", "string"]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string"
          },
          "text_original": {
            "type": "string"
          },
          "text_corrected": {
            "type": ["string", "null"]
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["word", "start", "end"],
              "properties": {
                "word": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["text"]
          },
          {
            "properties": {
              "text_original": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["text_original"]
          },
          {
            "properties": {
              "words": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": ["words"]
          }
        ]
      }
    }
  },
  "definitions": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
