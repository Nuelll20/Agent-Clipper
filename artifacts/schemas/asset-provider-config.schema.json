{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hermes Local Asset Provider Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "providers"],
  "properties": {
    "artifact_type": {"const": "asset-provider-config"},
    "schema_version": {"const": "1.0"},
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "animation", "voice", "sfx"],
      "properties": {
        "reference": {"$ref": "#/definitions/provider"},
        "animation": {"$ref": "#/definitions/provider"},
        "voice": {"$ref": "#/definitions/provider"},
        "sfx": {"$ref": "#/definitions/provider"}
      }
    }
  },
  "definitions": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "output_extension", "timeout_seconds"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "command": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "output_extension": {"type": "string", "pattern": "^\\.[A-Za-z0-9]{1,8}$"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400}
      }
    }
  }
}
