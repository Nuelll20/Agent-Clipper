{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hermes Scene Graph",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "producer_version",
    "source_fingerprint",
    "config_fingerprint",
    "created_at",
    "upstream_artifacts",
    "scenes"
  ],
  "properties": {
    "artifact_type": {
      "const": "scene-graph"
    },
    "schema_version": {
      "const": "2.0"
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "source_fingerprint": {
      "$ref": "#/definitions/fingerprint"
    },
    "config_fingerprint": {
      "$ref": "#/definitions/fingerprint"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "upstream_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/fingerprint"
      },
      "uniqueItems": true
    },
    "scenes": {
      "type": "array"
    }
  },
  "definitions": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
