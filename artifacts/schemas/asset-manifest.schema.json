{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hermes Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "schema_version", "producer_version", "story_id",
    "revision_id", "production_id", "plan_fingerprint", "created_at",
    "updated_at", "status", "shots"
  ],
  "properties": {
    "artifact_type": {"const": "asset-manifest"},
    "schema_version": {"const": "2.0"},
    "producer_version": {"type": "string", "minLength": 1},
    "story_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "production_id": {"type": "string", "minLength": 1},
    "plan_fingerprint": {"$ref": "#/definitions/fingerprint"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PENDING", "PARTIAL", "FAILED", "COMPLETED"]},
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["shot_id", "assets"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "assets": {
            "type": "object",
            "additionalProperties": {
              "type": "object", "additionalProperties": false,
              "required": ["state", "active_attempt", "attempts"],
              "properties": {
                "state": {"enum": ["PENDING", "COMPLETED", "FAILED", "STALE"]},
                "active_attempt": {"type": ["string", "null"]},
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["attempt_id", "state", "path", "fingerprint"],
                    "properties": {
                      "attempt_id": {"type": "string", "minLength": 1},
                      "state": {"enum": ["COMPLETED", "FAILED"]},
                      "path": {"type": "string", "minLength": 1},
                      "fingerprint": {"$ref": "#/definitions/fingerprint"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
